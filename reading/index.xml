&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; echo &lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt;&lt;span style="color:#00f"&gt;$(&lt;/span&gt;date&lt;span style="color:#00f"&gt;)&lt;/span&gt;&lt;span style="color:#a31515"&gt;: 开始备份 &lt;/span&gt;$source_dir&lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt; &amp;gt;&amp;gt; &lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt;$LOG_FILE&lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; tar -czf &lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt;$BACKUP_DIR&lt;span style="color:#a31515"&gt;/&lt;/span&gt;$backup_name&lt;span style="color:#a31515"&gt;-&lt;/span&gt;&lt;span style="color:#00f"&gt;$(&lt;/span&gt;date +%Y%m%d&lt;span style="color:#00f"&gt;)&lt;/span&gt;&lt;span style="color:#a31515"&gt;.tar.gz&amp;#34;&lt;/span&gt; &lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt;$source_dir&lt;span style="color:#a31515"&gt;&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 
